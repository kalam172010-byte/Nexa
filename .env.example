# PORT: Server port (defaults to 3000)
PORT="3000"

# JWT_SECRET: Secret key for signing session tokens
JWT_SECRET="nexa_super_secure_gaming_jwt_secret_99818"

# PAYMENT_GATEWAY_API_KEY: Upstream payment gateway secret key
PAYMENT_GATEWAY_API_KEY="sk_live_nexa_99818471203"

# UPI_VPA: Default UPI Virtual Payment Address for QR Code Deposits
UPI_VPA="nexapanel@upi"

# RESELLER_API_MASTER_KEY: Upstream reseller master API key
RESELLER_API_MASTER_KEY="reseller_key_live_9941"

# DATABASE_URL: Optional PostgreSQL connection string (defaults to JSON/SQLite layer)
DATABASE_URL="postgresql://user:password@localhost:5432/nexapanel"
