rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin authorization check: bootstrapped runtime admin or registered admin role
    function isAdmin() {
      return isSignedIn() && (
        ((request.auth.token.email == 'kk7953926@gmail.com' || request.auth.token.email == 'kalam172010@gmail.com' || request.auth.token.email == 'kalamkalam1234kd@gmail.com') && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- CONNECTION HEALTH CHECK ---
    match /test/{testId} {
      allow get: if true;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get, list: if true;

      allow create: if isValidId(userId) &&
        incoming().id == userId &&
        incoming().email is string &&
        incoming().email.size() <= 256 &&
        incoming().username is string &&
        incoming().username.size() <= 64 &&
        incoming().balance is number &&
        incoming().balance >= 0;

      allow update: if isValidId(userId) &&
        (!('balance' in incoming()) || (incoming().balance is number && incoming().balance >= 0));

      allow delete: if isAdmin();
    }

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- PRODUCT VARIANTS COLLECTION ---
    match /productVariants/{variantId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- DIGITAL KEYS INVENTORY ---
    match /digitalKeys/{keyId} {
      allow get, list: if true;
      allow create, update: if isValidId(keyId) &&
        incoming().keyCode is string &&
        incoming().status in ['ACTIVE', 'USED', 'EXPIRED'];
      allow delete: if isSignedIn();
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update: if isValidId(orderId) &&
        incoming().userId is string &&
        incoming().status in ['COMPLETED', 'FAILED', 'PENDING'];
      allow delete: if isAdmin();
    }

    // --- TRANSACTIONS COLLECTION ---
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create: if isValidId(transactionId) &&
        incoming().userId is string &&
        incoming().amount is number &&
        incoming().type in ['CREDIT', 'DEBIT', 'PURCHASE', 'DEPOSIT', 'REFERRAL_BONUS', 'ADMIN_ADJUST', 'REFUND'];
      allow update, delete: if isAdmin();
    }

    // --- DEPOSITS COLLECTION ---
    match /deposits/{depositId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- SUPPORT TICKETS ---
    match /supportTickets/{ticketId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- SUPPORT MESSAGES ---
    match /supportMessages/{messageId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- SYSTEM & SETTINGS CONFIGURATION ---
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
