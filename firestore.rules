rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow server-side REST synchronization and real-time client listeners across collections
    match /users/{userId} {
      allow read, write: if true;
    }

    match /digitalKeys/{keyId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /transactions/{txId} {
      allow read, write: if true;
    }

    match /walletTransactions/{txId} {
      allow read, write: if true;
    }

    match /deposits/{depositId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /productVariants/{variantId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
